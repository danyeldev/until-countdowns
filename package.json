    "astronomy-engine": "^2.1.19",
    "aws4fetch": "^1.0.20",
    "date-holidays": "^3.36.1",
    "lunar-typescript": "^1.8.6",
    "next": "16.3.4",
    "next-intl": "^4.14.5",
    "panchang-ts": "^5.2.1",
    "posthog-js": "^1.433.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
