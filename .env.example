# Site
NEXT_PUBLIC_SITE_URL=https://until.day
GOOGLE_SITE_VERIFICATION=

# Supabase (new key format; see supabase.com/docs/guides/api/api-keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=event-images

# Cloudflare R2 (catalog and collection photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=until-images
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.until.day
# Auth: enable Email and Google in the Supabase dashboard (Authentication > Providers).
# Site URL = NEXT_PUBLIC_SITE_URL. Additional Redirect URLs must include
# {SITE}/auth/callback and http://localhost:3000/auth/callback.
# Google needs a Web client ID/secret; the provider callback is
# https://<project-ref>.supabase.co/auth/v1/callback.

# Ingestion (Vercel Cron sends CRON_SECRET as "Authorization: Bearer ...")
CRON_SECRET=
INGEST_ENABLED=false
INGEST_BUDGET_MS=240000
INGEST_USER_AGENT="UntilCountdowns/2.0 (https://github.com/danyeldev/until-countdowns; contact@example.com)"

# Optional adapter keys (adapters self-disable when absent)
FOOTBALL_DATA_API_KEY=
LL2_API_TOKEN=
NASA_API_KEY=
PANDASCORE_TOKEN=
RESEND_API_KEY=
ALERT_EMAIL=

# Free sources require no additional key: F1Calendar, TVMaze, OpenHolidays,
# endoflife.date, confs.tech, MusicBrainz, Hebcal, AlAdhan and Wikimedia.
# See docs/data-sources.md for coverage, attribution and access conditions.
TVMAZE_MIN_WEIGHT=80
OPENHOLIDAYS_INCLUDE_SUBDIVISIONS=false
HINDU_INCLUDE_ALL=false

# Optional anime feeds (disabled until explicitly enabled)
ANIMESCHEDULE_ENABLED=false
KITSU_ENABLED=false

# Optional pages to prerender per catalog route family (default 0: render on first visit with ISR).
CATALOG_PRERENDER_LIMIT=0
